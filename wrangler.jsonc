{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tsnms-erp",
  "main": "cf-worker.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "*.campustwin.org/*", "zone_name": "campustwin.org" },
    { "pattern": "campustwin.org/auth/*", "zone_name": "campustwin.org" }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  }
}
