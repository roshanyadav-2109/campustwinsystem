{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tsnms-erp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "campustwin.org", "custom_domain": true },
    { "pattern": "*.campustwin.org/*", "zone_name": "campustwin.org" }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  }
}
